# Copy this file to .env for local development convenience (optional).
# NOTE: app.py currently reads API keys from the Streamlit sidebar at runtime,
# NOT from environment variables. This file is provided for future extensibility
# (e.g., if you later add os.getenv() fallbacks or local testing scripts).

GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
